# Root-level overrides for docker-compose.yml. Copy to `.env` and adjust.
# Only settings that vary by deployment target (dev machine vs on-prem) live
# here — service-internal secrets (JWT keys, Stripe, SMTP) go in backend/.env.
# See docs/on-premise.md for the full on-prem/air-gapped deployment guide.

# --- Database -----------------------------------------------------------
# Default targets the native Postgres service documented in RUNNING.md,
# reachable from Docker via host.docker.internal. For a fully self-contained
# on-prem deployment, run `docker compose --profile onprem up -d` (which
# starts a bundled Postgres container) and set DB_HOST=postgres below.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=khalid
DB_NAME=aidb

# --- Air-gapped / offline mode -------------------------------------------
# When true, the llm-init service will not attempt to download the default
# GGUF model from Hugging Face at startup. Place your own GGUF file at
# /models/model.gguf inside the ai-platform_llm_models volume beforehand.
OFFLINE_MODE=false

# --- Container sandboxing (F3) -------------------------------------------
# Model containers run with dropped capabilities, no-new-privileges, a
# read-only rootfs, and a pids limit by default. Set to false only if a
# specific framework's runtime needs a capability or writable path this
# doesn't anticipate.
MODEL_SANDBOX_HARDENING_ENABLED=true
