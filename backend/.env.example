# Backend service configuration. Copy to backend/.env and fill in real
# values for anything sent to a third party (Stripe, SMTP). Everything below
# has a working default for local development — see docs/on-premise.md for
# guidance on which of these matter for a production/on-prem deployment.

# --- Database (overridden by docker-compose.yml's own DB_* env block when
# running via `docker compose up`; these apply when running `npm run dev`
# directly on the host) ----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=khalid
DB_NAME=aidb

# --- Redis / MinIO / OpenSearch (defaults match docker-compose.yml) ------
REDIS_HOST=localhost
REDIS_PORT=6380
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=models
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=mlhub-models

# --- Auth -----------------------------------------------------------------
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY: RS256 PEM key pair. If unset, a key pair
# is generated in-memory on boot — fine for a single dev instance, but every
# restart invalidates existing sessions and every horizontally-scaled
# backend replica would sign with a different key. Set fixed keys for any
# multi-replica or persistent-session deployment (e.g. on-prem production).
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# --- Model build/deploy pipeline -------------------------------------------
GGUF_STORAGE_PATH=./uploads/gguf-models
WEIGHTS_STORAGE_PATH=./uploads/model-weights
BUILD_QUEUE_CONCURRENCY=2
DEPLOY_QUEUE_CONCURRENCY=3
MAX_SYSTEM_RAM_MB=3072
IDLE_TIMEOUT_MS=300000
HEALTH_PROBE_TIMEOUT_MS=3000
BASE_IMAGE_REGISTRY=
# F3: container sandboxing (CapDrop, no-new-privileges, read-only rootfs,
# isolated egress network). Set to false only if a specific framework's
# runtime needs a capability or writable path this doesn't anticipate.
MODEL_SANDBOX_HARDENING_ENABLED=true
# F6: skip the default GGUF model download at boot for air-gapped installs.
OFFLINE_MODE=false

# --- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# --- URLs / CORS ------------------------------------------------------------
PUBLIC_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# --- Mail (SMTP) — required for verification/reset emails and security
# alerts; leave unset in dev to no-op mail sending ---------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- Stripe — required only if billing/credit top-ups are exercised --------
# STRIPE_SECRET_KEY=
# STRIPE_WALLETS_WEBHOOK_SECRET=
# STRIPE_PAYMENTS_WEBHOOK_SECRET=

# --- Admin seed (used by `npm run create:admin`) ----------------------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=
